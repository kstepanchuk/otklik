# Список файлов в папках не показывается.
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # Страницы всегда сверяются с сервером: после обновления браузер не покажет старую версию.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Страницы кабинета нельзя встроить в чужой сайт; экран и телефон встраивать можно.
  <FilesMatch "^(dashboard|editor|host|remote|admin|report|login|register|reset)\.html$">
    Header always set X-Frame-Options "SAMEORIGIN"
  </FilesMatch>
</IfModule>
